# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# the local Postgres (PGlite) database — the dev-time replacement for data/*.db
/.pglite/

# the library itself, and its snapshots — real content, not source
/data/*.db
/data/*.db-wal
/data/*.db-shm
/backups/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch
/tmp/
*.bak

# an empty repo scaffold that landed a directory too deep (no commits, no remote)
/AscentSite/

# Generated by the render harnesses (scripts/render-loader.mjs) — a shim for
# next/navigation, rewritten on every run.
scripts/.render-nav-shim.mjs

# cloudflared and any other downloaded binaries — 50MB+, and a machine-local
# concern rather than part of the app.
.tools/

# Database dumps — the library, in plain JSON. Keep them, do not commit them.
backups/
